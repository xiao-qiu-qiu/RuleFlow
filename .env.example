# 服务器
PORT=8080
SURGE_MANAGED_CONFIG_BASE_URL=

# CORS 配置（逗号分隔的允许来源，例如 "https://example.com,https://app.example.com"）
CORS_ALLOWED_ORIGINS=*

# PostgreSQL
DATABASE_URL=postgresql://ruleflow:password@localhost:5432/ruleflow?sslmode=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# 缓存
CACHE_TTL_SECONDS=3600

# 日志清理配置
LOG_KEEP_DAYS=30
LOG_MAX_RECORDS=10000
LOG_CHECK_INTERVAL=1

# 入口网关（可选）：把面板藏在一个随机入口路径下，其他路径返回伪装页
# 留空表示关闭，行为与旧版本一致。详见 docs/入口网关与伪装页.md
RF_ENTRY_PATH=
# 放行面板内部请求（前端绝对路径跳转、/api、/assets）的 cookie 值
# 留空则由 RF_ENTRY_PATH 派生
RF_ENTRY_COOKIE=

# 生成订阅 / 规则集绝对 URL 用的公开地址
# 面板挂在随机路径下时，这里要带上同样的路径前缀
PUBLIC_BASE_URL=
